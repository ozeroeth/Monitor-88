# === Telegram Bot ===
BOT_TOKEN=your_telegram_bot_token_here

# === Optional: restrict bot to specific chat IDs (comma separated) ===
# Leave empty to allow anyone
ALLOWED_CHAT_IDS=

# === 985monitor API base (no trailing slash) ===
API_BASE=https://985monitor.xyz

# === Polling intervals (ms) ===
POLL_INTERVAL_MS=60000
NFT_POLL_INTERVAL_MS=30000
FOMO_CACHE_INTERVAL_MS=3600000

# === SSE reconnect delay (ms) ===
SSE_RECONNECT_DELAY_MS=5000
